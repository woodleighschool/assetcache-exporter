    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Used cache as a fraction of usable capacity. Apple defines CacheLimit=0 as unlimited, so the denominator falls back to CacheUsed + CacheFree instead of treating zero as a zero-byte limit.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "builder",
          "expr": "assetcache_cache_used_bytes{instance=~\"$instance\"}\n/\n(\n  ((assetcache_cache_limit_bytes{instance=~\"$instance\"} > bool 0) * assetcache_cache_limit_bytes{instance=~\"$instance\"})\n  +\n  ((assetcache_cache_limit_bytes{instance=~\"$instance\"} == bool 0) * (assetcache_cache_used_bytes{instance=~\"$instance\"} + assetcache_cache_free_bytes{instance=~\"$instance\"}))\n)",
          "instant": true,
          "legendFormat": "Used",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Cache usage",
      "type": "stat"
    },
